# Kopieren nach .env und anpassen. Die Datei .env nie einchecken.

# Datenbank-Passwort, z. B. erzeugen mit: openssl rand -base64 24
POSTGRES_PASSWORD=bitte-aendern

# Öffentliche Adresse inklusive Basispfad; landet im Einstiegs-QR der Teams.
PUBLIC_URL=https://riegel-troisdorf.de/lykora
BASE_PATH=/lykora

# Erster Admin; wird nur angelegt, solange es noch keinen Nutzer gibt.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Geheimnis für eingehende SOS-SMS vom SMS-Gateway. Leer lassen schaltet den Eingang ab.
SMS_WEBHOOK_SECRET=

# Port auf dem Host; nur an 127.0.0.1 gebunden.
PORT=3000
BIND_ADDRESS=127.0.0.1
LOG_LEVEL=info

# Image von Server und Updater. Die CI veröffentlicht nach jedem grünen Push:
#   ghcr.io/wolfsrudel-gaming/lykora:testbuild  neuester Push, egal welcher Branch (wie die Test-APK)
#   ghcr.io/wolfsrudel-gaming/lykora:latest     neuester Stand von main
#   ghcr.io/wolfsrudel-gaming/lykora:<branch>   neuester Stand eines Branches, z. B. :main
# Kanal wechseln: Wert ändern, dann docker compose pull && docker compose up -d
# Selbst bauen ohne automatische Updates: LYKORA_IMAGE=lykora-server:latest und docker compose up -d --build
LYKORA_IMAGE=ghcr.io/wolfsrudel-gaming/lykora:testbuild

# Zeitzone für das Zeitfenster der automatischen Updates (Einstellungen im Dashboard).
UPDATE_TIMEZONE=Europe/Berlin

# Das Paket auf ghcr.io ist nach dem ersten Lauf der CI privat (docker compose pull: "denied"; Dashboard:
# "Image nicht gefunden oder nicht öffentlich"). Einmalig freigeben: GitHub → Organisation → Packages → lykora
# → Package settings → Change visibility → Public. Oder hier GitHub-Nutzer und Personal Access Token mit dem
# Recht read:packages eintragen; Server und Updater melden sich damit an.
LYKORA_REGISTRY_USER=
LYKORA_REGISTRY_TOKEN=

# Docker-Socket für den Updater; nur ändern, wenn Docker woanders lauscht (z. B. rootless).
DOCKER_SOCKET=/var/run/docker.sock
