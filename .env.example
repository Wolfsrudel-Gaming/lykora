# Kopieren nach .env und anpassen. Die Datei .env nie einchecken.

# Datenbank-Passwort, z. B. erzeugen mit: openssl rand -base64 24
POSTGRES_PASSWORD=bitte-aendern

# Öffentliche Adresse inklusive Basispfad; landet im Einstiegs-QR der Teams.
PUBLIC_URL=https://riegel-troisdorf.de/lykora
BASE_PATH=/lykora

# Erster Admin; wird nur angelegt, solange es noch keinen Nutzer gibt.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Geheimnis für eingehende SOS-SMS vom SMS-Gateway. Leer lassen schaltet den Eingang ab.
SMS_WEBHOOK_SECRET=

# Port auf dem Host; nur an 127.0.0.1 gebunden.
PORT=3000
BIND_ADDRESS=127.0.0.1
LOG_LEVEL=info
