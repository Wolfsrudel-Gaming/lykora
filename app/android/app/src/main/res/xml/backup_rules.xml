<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 und älter: dieselbe Regel wie in data_extraction_rules.xml, nichts wird gesichert. -->
<full-backup-content>
    <exclude domain="root"/>
    <exclude domain="file"/>
    <exclude domain="database"/>
    <exclude domain="sharedpref"/>
    <exclude domain="external"/>
</full-backup-content>
